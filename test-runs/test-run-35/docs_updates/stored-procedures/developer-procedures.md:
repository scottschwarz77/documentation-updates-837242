+## Error handling and audit logging patterns
+- Use BEGIN...EXCEPTION blocks to catch OTHERS, log the input_snapshot and SQLERRM with SQLSTATE into developer_procedure_logs, then re-raise or return a standardized error.
+- Use consistent ERRCODE values for common classes (P0001 conflict, P0002 validation, P0003 permission).
+
+## Bulk operations and upsert
+-- Bulk insert using jsonb_to_recordset
+CREATE OR REPLACE FUNCTION CreateDevelopersBulk(in_payload jsonb, in_created_by bigint) RETURNS integer
+LANGUAGE plpgsql AS $$
+DECLARE
+    v_rows integer := 0;
+BEGIN
+    INSERT INTO developers (username, email, bio, skills, created_at)
+    SELECT p.username, p.email, p.bio, p.skills::jsonb, now()
+    FROM jsonb_to_recordset(in_payload) AS p(username text, email text, bio text, skills jsonb);
+
+    GET DIAGNOSTICS v_rows = ROW_COUNT;
+    INSERT INTO developer_procedure_metrics (procedure_name, execution_time_ms, rows_affected)
+    VALUES ('CreateDevelopersBulk', 0, v_rows); -- measure execution_time_ms if desired
+    RETURN v_rows;
+END;
+$$;
+
+-- Upsert bulk (example using ON CONFLICT)
+CREATE OR REPLACE FUNCTION UpsertDevelopersBulk(in_payload jsonb, in_upsert_by bigint) RETURNS integer
+LANGUAGE plpgsql AS $$
+DECLARE
+    v_rows integer := 0;
+BEGIN
+    INSERT INTO developers (username, email, bio, skills, created_at)
+    SELECT p.username, p.email, p.bio, p.skills::jsonb, now()
+    FROM jsonb_to_recordset(in_payload) AS p(username text, email text, bio text, skills jsonb)
+    ON CONFLICT (username) DO UPDATE SET
+        email = EXCLUDED.email,
+        bio = EXCLUDED.bio,
+        skills = EXCLUDED.skills,
+        updated_at = now();
+
+    GET DIAGNOSTICS v_rows = ROW_COUNT;
+    RETURN v_rows;
+END;
+$$;
