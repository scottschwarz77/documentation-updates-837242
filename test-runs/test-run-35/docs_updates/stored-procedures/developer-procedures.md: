+## Overview and conventions
+- Prefer using SQL functions (RETURNS TABLE or RECORD) when you need to return rows; use CREATE PROCEDURE when you need CALL semantics (and may manage transactions). This doc uses a mix: functions for reads, procedures/functions for writes depending on return shape.
+- Standardize return patterns:
+  - Successful create: return row (including id, created_at) or OUT id, created_at.
+  - Failure: raise a controlled exception with SQLSTATE or return a standardized JSON error object (choose one per project).
+- Use PL/pgSQL exception blocks to capture constraint violations and write structured logs to an audit table.
+- Validation helper returns boolean and an optional message or raises exception for immediate aborts.
+
+## Table schemas (examples)
+CREATE TABLE developers (
+    id bigserial PRIMARY KEY,
+    username text NOT NULL UNIQUE,
+    email text NOT NULL UNIQUE,
+    bio text,
+    skills jsonb DEFAULT '[]'::jsonb,
+    social_links jsonb DEFAULT '{}'::jsonb,
+    created_at timestamptz NOT NULL DEFAULT now(),
+    updated_at timestamptz,
+    deleted_at timestamptz,
+    deleted_by bigint
+);
+
+CREATE TABLE developer_procedure_logs (
+    id bigserial PRIMARY KEY,
+    procedure_name text NOT NULL,
+    input_snapshot jsonb,
+    error_message text,
+    error_code text,
+    executed_by bigint,
+    created_at timestamptz NOT NULL DEFAULT now()
+);
+
+CREATE TABLE developer_procedure_metrics (
+    id bigserial PRIMARY KEY,
+    procedure_name text NOT NULL,
+    execution_time_ms integer,
+    rows_affected integer,
+    created_at timestamptz NOT NULL DEFAULT now()
+);
+
+## Procedure signatures and types (recommended)
+- CreateDeveloper(username text, email text, bio text DEFAULT NULL, skills_json jsonb DEFAULT '[]'::jsonb, created_by bigint)
+  - Returns: TABLE(id bigint, created_at timestamptz) or function that RETURNS RECORD with OUT id, created_at.
+  - On failure: raise exception with SQLSTATE or RAISE EXCEPTION 'conflict' USING ERRCODE = 'P0001' (or return JSON error object).
+
+- GetDeveloperById(dev_id bigint)
+  - Returns: developers row as TABLE or RECORD, with skills and social_links as JSONB.
+  - On not found: return NULL row (i.e., empty result) or raise NOT FOUND depending on API convention.
+
+- UpdateDeveloper(dev_id bigint, email text DEFAULT NULL, bio text DEFAULT NULL, skills_json jsonb DEFAULT NULL, current_user_id bigint)
+  - Returns: updated row (RECORD) or boolean + updated_at.
+  - On permission denied: raise controlled exception with code 'permission_denied' or SQLSTATE 'P0003'.
+
+- DeleteDeveloper(dev_id bigint, current_user_id bigint, hard_delete boolean DEFAULT false)
+  - Returns: boolean (true if deleted).
+  - Default: perform soft delete by setting deleted_at and deleted_by; if hard_delete=true, perform hard DELETE.
+
+- ListDevelopers(limit integer DEFAULT 50, offset integer DEFAULT 0, sort_by text DEFAULT 'created_at')
+  - Returns: SETOF developers (paged).
+  - Support keyset pagination variant: ListDevelopersKeyset(limit integer, last_id bigint, last_value text, sort_by text)
+
+## Example procedure bodies
+
+-- CreateDeveloper (function returning id and created_at)
+CREATE OR REPLACE FUNCTION CreateDeveloper(
+    in_username text,
+    in_email text,
+    in_bio text DEFAULT NULL,
+    in_skills jsonb DEFAULT '[]'::jsonb,
+    in_created_by bigint DEFAULT NULL
+) RETURNS TABLE (id bigint, created_at timestamptz)
+LANGUAGE plpgsql AS $$
+DECLARE
+    v_exists boolean;
+    v_now timestamptz := now();
+BEGIN
+    -- Input validation: username/email basic checks (delegated to ValidateDeveloperInput)
+    PERFORM ValidateDeveloperInput(in_username, in_email, in_skills);
+
+    -- Check uniqueness
+    IF EXISTS (SELECT 1 FROM developers WHERE username = in_username) THEN
+        RAISE EXCEPTION 'username_conflict' USING ERRCODE = 'P0001';
+    END IF;
+    IF EXISTS (SELECT 1 FROM developers WHERE email = in_email) THEN
+        RAISE EXCEPTION 'email_conflict' USING ERRCODE = 'P0001';
+    END IF;
+
+    INSERT INTO developers (username, email, bio, skills, created_at)
+    VALUES (in_username, in_email, in_bio, COALESCE(in_skills, '[]'::jsonb), v_now)
+    RETURNING id, created_at INTO id, created_at;
+
+    RETURN NEXT;
+EXCEPTION WHEN OTHERS THEN
+    -- Log and re-raise
+    INSERT INTO developer_procedure_logs(procedure_name, input_snapshot, error_message, error_code, executed_by)
+    VALUES ('CreateDeveloper', jsonb_build_object('username', in_username, 'email', in_email, 'bio', in_bio, 'skills', in_skills), SQLERRM, SQLSTATE, in_created_by);
+    RAISE;
+END;
+$$;
+
+-- GetDeveloperById
+CREATE OR REPLACE FUNCTION GetDeveloperById(in_dev_id bigint) RETURNS TABLE (
+    id bigint, username text, email text, bio text, skills jsonb, social_links jsonb, created_at timestamptz, updated_at timestamptz, deleted_at timestamptz
+) LANGUAGE plpgsql AS $$
+BEGIN
+    RETURN QUERY
+    SELECT id, username, email, bio, skills, social_links, created_at, updated_at, deleted_at
+    FROM developers
+    WHERE id = in_dev_id;
+END;
+$$;
+
+-- UpdateDeveloper: partial updates (only non-null inputs), with auth check
+CREATE OR REPLACE FUNCTION UpdateDeveloper(
+    in_dev_id bigint,
+    in_email text DEFAULT NULL,
+    in_bio text DEFAULT NULL,
+    in_skills jsonb DEFAULT NULL,
+    in_current_user_id bigint
+) RETURNS TABLE (id bigint, username text, email text, bio text, skills jsonb, updated_at timestamptz)
+LANGUAGE plpgsql AS $$
+DECLARE
+    v_row developers%ROWTYPE;
+BEGIN
+    -- Existence check
+    SELECT * INTO v_row FROM developers WHERE id = in_dev_id AND deleted_at IS NULL;
+    IF NOT FOUND THEN
+        RETURN; -- returns no rows (caller interprets as not found)
+    END IF;
+
+    -- Authorization example: allow update if admin or owner
+    PERFORM CheckIsAdminOrOwner(in_current_user_id, in_dev_id); -- raises if unauthorized
+
+    -- Apply partial updates
+    UPDATE developers SET
+        email = COALESCE(in_email, email),
+        bio = COALESCE(in_bio, bio),
+        skills = COALESCE(in_skills, skills),
+        updated_at = now()
+    WHERE id = in_dev_id
+    RETURNING id, username, email, bio, skills, updated_at INTO id, username, email, bio, skills, updated_at;
+
+    RETURN NEXT;
+EXCEPTION WHEN OTHERS THEN
+    INSERT INTO developer_procedure_logs(procedure_name, input_snapshot, error_message, error_code, executed_by)
+    VALUES ('UpdateDeveloper', jsonb_build_object('id', in_dev_id, 'email', in_email, 'bio', in_bio, 'skills', in_skills), SQLERRM, SQLSTATE, in_current_user_id);
+    RAISE;
+END;
+$$;
+
+-- DeleteDeveloper: soft delete by default
+CREATE OR REPLACE FUNCTION DeleteDeveloper(in_dev_id bigint, in_current_user_id bigint, in_hard_delete boolean DEFAULT false) RETURNS boolean
+LANGUAGE plpgsql AS $$
+BEGIN
+    PERFORM CheckIsAdminOrOwner(in_current_user_id, in_dev_id); -- raises if unauthorized
+
+    IF in_hard_delete THEN
+        DELETE FROM developers WHERE id = in_dev_id;
+        RETURN FOUND;
+    ELSE
+        UPDATE developers SET deleted_at = now(), deleted_by = in_current_user_id WHERE id = in_dev_id;
+        RETURN FOUND;
+    END IF;
+EXCEPTION WHEN OTHERS THEN
+    INSERT INTO developer_procedure_logs(procedure_name, input_snapshot, error_message, error_code, executed_by)
+    VALUES ('DeleteDeveloper', jsonb_build_object('id', in_dev_id, 'hard_delete', in_hard_delete), SQLERRM, SQLSTATE, in_current_user_id);
+    RAISE;
+END;
+$$;
+
+-- ListDevelopers with LIMIT/OFFSET
+CREATE OR REPLACE FUNCTION ListDevelopers(in_limit integer DEFAULT 50, in_offset integer DEFAULT 0, in_sort_by text DEFAULT 'created_at') RETURNS SETOF developers
+LANGUAGE plpgsql AS $$
+BEGIN
+    RETURN QUERY EXECUTE format('SELECT * FROM developers WHERE deleted_at IS NULL ORDER BY %I DESC LIMIT $1 OFFSET $2', in_sort_by) USING in_limit, in_offset;
+END;
+$$;
+
+-- Keyset pagination pattern example (minimal)
+CREATE OR REPLACE FUNCTION ListDevelopersKeyset(in_limit integer DEFAULT 50, in_last_created_at timestamptz DEFAULT NULL) RETURNS SETOF developers
+LANGUAGE plpgsql AS $$
+BEGIN
+    IF in_last_created_at IS NULL THEN
+        RETURN QUERY SELECT * FROM developers WHERE deleted_at IS NULL ORDER BY created_at DESC LIMIT in_limit;
+    ELSE
+        RETURN QUERY SELECT * FROM developers WHERE deleted_at IS NULL AND created_at < in_last_created_at ORDER BY created_at DESC LIMIT in_limit;
+    END IF;
+END;
+$$;
