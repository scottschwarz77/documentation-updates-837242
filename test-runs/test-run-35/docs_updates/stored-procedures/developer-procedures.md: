+## Validation helper
+-- ValidateDeveloperInput: raises exception on invalid input
+CREATE OR REPLACE FUNCTION ValidateDeveloperInput(in_username text, in_email text, in_skills jsonb) RETURNS boolean
+LANGUAGE plpgsql AS $$
+BEGIN
+    IF in_username IS NULL OR length(trim(in_username)) < 3 OR length(in_username) > 50 THEN
+        RAISE EXCEPTION 'invalid_username' USING ERRCODE = 'P0002';
+    END IF;
+    IF in_username ~ '[^a-zA-Z0-9_.-]' THEN
+        RAISE EXCEPTION 'invalid_username_chars' USING ERRCODE = 'P0002';
+    END IF;
+    IF in_email !~* '^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$' THEN
+        RAISE EXCEPTION 'invalid_email' USING ERRCODE = 'P0002';
+    END IF;
+    -- Ensure skills is JSON array
+    IF in_skills IS NOT NULL AND jsonb_typeof(in_skills) <> 'array' THEN
+        RAISE EXCEPTION 'invalid_skills_format' USING ERRCODE = 'P0002';
+    END IF;
+    RETURN true;
+END;
+$$;
