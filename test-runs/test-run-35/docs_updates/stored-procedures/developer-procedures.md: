+## Authorization helper
+-- CheckIsAdminOrOwner: example pattern. Replace check by real role lookup.
+CREATE OR REPLACE FUNCTION CheckIsAdminOrOwner(in_user_id bigint, in_dev_id bigint) RETURNS boolean
+LANGUAGE plpgsql AS $$
+DECLARE
+    v_is_admin boolean := false;
+    v_owner_id bigint;
+BEGIN
+    -- Placeholder admin check (replace with real role lookup)
+    SELECT EXISTS(SELECT 1 FROM users_roles ur WHERE ur.user_id = in_user_id AND ur.role = 'admin') INTO v_is_admin;
+    SELECT id INTO v_owner_id FROM developers WHERE id = in_dev_id LIMIT 1;
+    IF v_is_admin OR v_owner_id = in_user_id THEN
+        RETURN true;
+    ELSE
+        RAISE EXCEPTION 'permission_denied' USING ERRCODE = 'P0003';
+    END IF;
+END;
+$$;
