+## Index recommendations
+- CREATE UNIQUE INDEX idx_developers_username ON developers(username);
+- CREATE UNIQUE INDEX idx_developers_email ON developers(email);
+- CREATE INDEX idx_developers_created_at ON developers(created_at);
+- CREATE INDEX idx_developers_last_active ON developers((social_links->>'last_active')) -- if last_active is stored in JSON (adjust type).
